:root {
  --stat3d-accent: #1f6feb;
  --stat3d-muted: #6b7280;
}

body {
  font-family: "Inter", "Segoe UI", Roboto, "Helvetica Neue", Arial, sans-serif;
  color: #111827;
  line-height: 1.6;
  background: #f4f5f7;
}

.page-columns {
  background: #f4f5f7;
}

.page-columns .content {
  max-width: 980px;
  background: #ffffff;
  border-radius: 14px;
  box-shadow: 0 10px 30px rgba(15, 23, 42, 0.08);
  padding: 2rem 2.5rem;
}

h1, h2, h3, h4 {
  font-weight: 600;
  letter-spacing: -0.01em;
}

h1 {
  border-bottom: 2px solid #e5e7eb;
  padding-bottom: 0.35rem;
}

h2 {
  margin-top: 2rem;
  border-bottom: 1px solid #e5e7eb;
  padding-bottom: 0.35rem;
}

a {
  color: var(--stat3d-accent);
}

code, pre {
  font-family: "JetBrains Mono", "Fira Code", Menlo, Consolas, monospace;
}

pre {
  background: #0b1220;
  color: #e5e7eb;
  border-radius: 8px;
  padding: 0.75rem 1rem;
}

table {
  border-collapse: collapse;
  width: 100%;
  margin: 1rem 0 1.5rem;
}

th, td {
  border: 1px solid #e5e7eb;
  padding: 0.5rem 0.75rem;
}

th {
  background: #f8fafc;
  text-align: left;
}

blockquote {
  border-left: 4px solid var(--stat3d-accent);
  padding-left: 1rem;
  color: #111827;
  background: #f8fafc;
}

.quarto-title-block {
  margin-bottom: 1.5rem;
}

.quarto-title-block .description {
  font-size: 1.05rem;
  color: #475569;
}

.quarto-title-meta {
  color: var(--stat3d-muted);
}

.quarto-figure {
  margin: 1.25rem 0;
}

.quarto-figure img {
  border: 1px solid #e5e7eb;
  border-radius: 6px;
}
